# Envasadoras que atiende este emitter (independientes). Lista separada por
# comas. Para agregar/renombrar una máquina, solo edita esta lista.
MACHINE_CODES=envasadora-1,envasadora-2,envasadora-3

# Monitor web de pruebas.
#   :3200            -> accesible desde la red (default)
#   127.0.0.1:3200   -> solo desde esta máquina
#   off              -> desactivado
PANEL_ADDR=:3200

# Servidor NATS de las envasadoras.
NATS_URL=nats://localhost:4222
NATS_USER=changeme
NATS_PASS=changeme
